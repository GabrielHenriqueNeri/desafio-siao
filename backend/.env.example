# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=desafio_siao

# Autenticação (troque o segredo em produção!)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# CORS — origem permitida do frontend
CORS_ORIGIN=http://localhost:5173

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
